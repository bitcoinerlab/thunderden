# The OCR worker needs only geometry and CPU inference. No GUI, video or file codecs.
set(BUILD_LIST "core,imgproc,dnn" CACHE STRING "" FORCE)
set(BUILD_SHARED_LIBS ON CACHE BOOL "" FORCE)
set(BUILD_PROTOBUF ON CACHE BOOL "" FORCE)
set(WITH_PROTOBUF ON CACHE BOOL "" FORCE)
set(OPENCV_GENERATE_PKGCONFIG ON CACHE BOOL "" FORCE)
foreach(flag BUILD_TESTS BUILD_PERF_TESTS BUILD_EXAMPLES BUILD_opencv_apps
    BUILD_JAVA BUILD_opencv_python2 BUILD_opencv_python3
    WITH_IPP WITH_ITT WITH_OPENCL WITH_LAPACK WITH_EIGEN WITH_TBB WITH_OPENMP
    WITH_PTHREADS_PF OPENCV_DNN_OPENCL WITH_CUDA WITH_OPENVINO)
  set(${flag} OFF CACHE BOOL "" FORCE)
endforeach()
set(CPU_DISPATCH "" CACHE STRING "" FORCE)
