# Thunder Den custom kernel config.
#
# Buildroot loads this file as BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE.
# The goal is a Thunder-Den-focused custom baseline (not x86_64_defconfig
# inheritance with large override lists).

# Keep a built-in fallback command line for EFI-stub boot paths.
# Do not trust CPU or bootloader entropy blindly.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty1 loglevel=3 random.trust_cpu=off random.trust_bootloader=off"
# CONFIG_CMDLINE_OVERRIDE is not set

CONFIG_SYSVIPC=y
# Runtime is initramfs-only; kernel module loading is unnecessary.
# CONFIG_MODULES is not set
# CONFIG_MODULE_UNLOAD is not set
CONFIG_SMP=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y

# Signer runtime does not require cgroup isolation features.
# CONFIG_CGROUPS is not set

CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# No firewall/packet filtering stack is needed for localhost RPC-only flow.
# CONFIG_NETFILTER is not set
# CONFIG_IPV6 is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_RFKILL is not set

CONFIG_PCI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Keep virtio transport for VM-based test coverage (UTM/QEMU).
# This is not required for real hardware booting from USB.
CONFIG_VIRTIO_PCI=y
# Zero host-disk policy: disable virtual and physical block-storage paths.
# Partition parser disables are best-effort; EFI Kconfig may force them on.
# CONFIG_VIRTIO_BLK is not set
# CONFIG_BLK_DEV_SD is not set
# CONFIG_SCSI_VIRTIO is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_ATA_PIIX is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_MSDOS_PARTITION is not set
CONFIG_NETDEVICES=y
# Keep loopback networking only; drop external NIC drivers.
# CONFIG_ETHERNET is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_NE2K_PCI is not set
# CONFIG_8139CP is not set
# CONFIG_E1000 is not set
# CONFIG_E1000E is not set
# CONFIG_R8169 is not set
# CONFIG_9P_FS is not set
# CONFIG_NET_9P is not set
# CONFIG_NET_9P_VIRTIO is not set
CONFIG_VIRTIO_CONSOLE=y
# CONFIG_VIRTIO_BALLOON is not set
CONFIG_VIRTIO_INPUT=y
# CONFIG_VIRTIO_MMIO is not set
# CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES is not set
# Keep VM entropy source for virtualization test runs.
CONFIG_HW_RANDOM_VIRTIO=y

# Add CPU-jitter entropy source as an additional seeding path.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_JITTERENTROPY=y

CONFIG_INPUT_EVDEV=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

CONFIG_DRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_QXL=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VGA_CONSOLE=y

CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
# Disable USB mass storage classes to reduce exfiltration surface.
# CONFIG_USB_STORAGE is not set
# CONFIG_UAS is not set

CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y

# Audio is unnecessary for signer runtime.
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_SND_HDA_INTEL is not set
# CONFIG_SND_HDA_GENERIC is not set

# Zero host-disk policy: no runtime disk filesystems/automount.
# Some base symbols (for example NLS) may be forced on by Kconfig defaults.
# CONFIG_EXT4_FS is not set
# CONFIG_AUTOFS4_FS is not set
# CONFIG_EFIVAR_FS is not set
# CONFIG_NLS is not set
# CONFIG_FS_POSIX_ACL is not set
CONFIG_TMPFS=y
# CONFIG_TMPFS_POSIX_ACL is not set
# CONFIG_TMPFS_XATTR is not set

# Reduce procfs introspection surface that is not required by runtime flow.
# These toggles are best-effort and may be forced by upstream defaults.
# CONFIG_PROC_PAGE_MONITOR is not set
# CONFIG_PROC_PID_ARCH_STATUS is not set

CONFIG_EFI=y
CONFIG_EFI_STUB=y

CONFIG_UNWINDER_FRAME_POINTER=y

# Trim runtime introspection/telemetry features not used by Thunder Den.
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_TRACING is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_AUDIT is not set

# Disable power-state and kexec surfaces for appliance-style usage.
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
