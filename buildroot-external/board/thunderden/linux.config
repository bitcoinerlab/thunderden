# Thunder Den minimal kernel config overrides.
#
# Buildroot merges this file via BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES.
# It is intentionally small: keep the Buildroot-selected x86_64 baseline
# (`BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG`) and only set signer-specific
# deltas here.
#
# Reference baseline config for pinned Buildroot release (2025.11.1):
# https://github.com/torvalds/linux/blob/v6.18/arch/x86/configs/x86_64_defconfig
#
# Keep a built-in fallback kernel cmdline. This helps tiny-image boot paths
# where no bootloader args may be passed (for example UEFI direct EFI-stub).
# Do not override bootloader-provided args so the max-compat GRUB path can
# still inject/adjust cmdline when needed.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty1 loglevel=3"
# CONFIG_CMDLINE_OVERRIDE is not set
#
# In Kconfig fragments, disabling a symbol uses this exact form:
#   # CONFIG_<NAME> is not set

CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y

# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_BT is not set
# CONFIG_RFKILL is not set

# Keep local RPC over localhost only; no external network interfaces.
# CONFIG_VIRTIO_NET is not set
# CONFIG_NE2K_PCI is not set
# CONFIG_8139CP is not set
# CONFIG_E1000 is not set
# CONFIG_E1000E is not set
# CONFIG_R8169 is not set
# CONFIG_IPV6 is not set

# Audio is not needed for signer operation.
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_SND_HDA_INTEL is not set
# CONFIG_SND_HDA_GENERIC is not set
# CONFIG_SND_SEQUENCER is not set
# CONFIG_SND_HRTIMER is not set

# Trim storage and automount surface; runtime root is initramfs.
# CONFIG_SCSI is not set
# CONFIG_BLK_DEV_SD is not set
# CONFIG_ATA is not set
# CONFIG_ATA_PIIX is not set
# CONFIG_EXT4_FS is not set
# CONFIG_AUTOFS4_FS is not set

# Boot uses EFI -> bzImage + initramfs root; USB mass-storage is unnecessary.
# CONFIG_USB_STORAGE is not set
# CONFIG_UAS is not set

# Not needed for target runtime.
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_MMIO is not set
# CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES is not set
